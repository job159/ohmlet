    "fw:list": "node firmware/build.mjs --list",
    "docs:support": "vite-node scripts/gen-support-matrix.mjs",
    "docs:support:check": "vite-node scripts/gen-support-matrix.mjs --check",
    "examples:build": "node scripts/build-examples.mjs",
    "examples:check": "node scripts/build-examples.mjs --check",
    "test:e2e": "node scripts/acceptance-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
