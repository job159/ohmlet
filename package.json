{
  "name": "ohmlet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firmware": "vitest run tests/firmware-checks.test.ts",
    "test:docs": "vitest run tests/docs-",
    "test:visual": "node scripts/visual-regression.mjs compare",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "fw:vendor": "node firmware/scripts/fetch-vendor.mjs",
